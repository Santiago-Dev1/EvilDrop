{
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.5",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "name": "evildrop",
  "version": "1.0.0",
  "description": "Backend y Frontend para la empresa EvilDrop, marca de ropa local colombiana.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node ./dist/index.js",
    "build": "rimraf ./dist && tsc",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "check": "npm run format:check && npm run lint:check && tsc --noEmit",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Santiago-Dev1/EvilDrop.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Santiago-Dev1/EvilDrop/issues"
  },
  "homepage": "https://github.com/Santiago-Dev1/EvilDrop#readme",
  "dependencies": {
    "fastify": "^5.6.2",
    "pg": "^8.16.3"
  }
}
